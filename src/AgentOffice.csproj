  <!--
    The VSTO build targets REQUIRE ClickOnce manifest signing.
    For development we sign with a self-signed temporary key (same as Visual
    Studio's "Create Test Certificate"); trust comes from the |vstolocal
    registry registration. Regenerate on a new machine with:
      powershell -ExecutionPolicy Bypass -File scripts\New-DevCertificate.ps1
    For production, the WiX MSI is signed with a real certificate.
  -->
  <PropertyGroup>
    <SignManifests>true</SignManifests>
    <ManifestKeyFile>AgentOffice_TemporaryKey.pfx</ManifestKeyFile>
    <!--
      Thumbprint of the dev certificate above (scripts\New-DevCertificate.ps1).
      The VSTO targets use it to register the cert in CurrentUser\Trusted
      Publishers, which is what makes the dev add-in load without prompts.
      Machine-specific: re-run the script and update this value on new machines.
    -->
    <ManifestCertificateThumbprint>0490B364242C1244AA48B6045DA51117E2EC6F09</ManifestCertificateThumbprint>
  </PropertyGroup>
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">10.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <!--
      VSTO design-time reference assemblies (Microsoft.Office.Tools.*.v4.0.Utilities)
      ship only inside the VS / Build Tools install and are NOT registered in the
      default MSBuild assembly search paths by Build Tools — so we probe both the
      VS and the MSBuild-relative locations explicitly.
    -->
    <VSTORefDir Condition="'$(VSTORefDir)' == '' and Exists('$(VSINSTALLDIR)Common7\IDE\ReferenceAssemblies\v4.0')">$(VSINSTALLDIR)Common7\IDE\ReferenceAssemblies\v4.0</VSTORefDir>
    <VSTORefDir Condition="'$(VSTORefDir)' == '' and Exists('$(MSBuildExtensionsPath32)\..\Common7\IDE\ReferenceAssemblies\v4.0')">$(MSBuildExtensionsPath32)\..\Common7\IDE\ReferenceAssemblies\v4.0</VSTORefDir>
  </PropertyGroup>
  <ItemGroup>
    <!--
      VSTO runtime assemblies (v9-style, GAC — provided by the VSTO Runtime).
      ApplicationFactory, CustomTaskPaneCollection, RibbonFactory, etc. live here.
    -->
    <Reference Include="Microsoft.Office.Tools, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Common, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Excel, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.v4.0.Framework, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <Reference Include="Microsoft.VisualStudio.Tools.Applications.Runtime, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <Private>False</Private>
    </Reference>
    <!--
      The v4.0.Utilities assemblies are NOT in the GAC at runtime:
      they must be deployed next to the add-in (Private = copy local).
      Design-time copies ship only inside VS / Build Tools → explicit HintPath.
    -->
    <Reference Include="Microsoft.Office.Tools.Common.v4.0.Utilities, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <HintPath>$(VSTORefDir)\Microsoft.Office.Tools.Common.v4.0.Utilities.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Office.Tools.Excel.v4.0.Utilities, Version=10.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a, processorArchitecture=MSIL">
      <HintPath>$(VSTORefDir)\Microsoft.Office.Tools.Excel.v4.0.Utilities.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Office PIAs — embedded so no PIA install is required at runtime. -->
    <Reference Include="Microsoft.Office.Interop.Excel, Version=15.0.0.0, Culture=neutral, PublicKeyToken=71e9bce111e9429c, processorArchitecture=MSIL">
      <EmbedInteropTypes>True</EmbedInteropTypes>
