<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <RootNamespace>AgentOffice.Tests</RootNamespace>
    <AssemblyName>AgentOffice.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <Deterministic>true</Deterministic>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <!-- Host-independent sources, compiled directly into the test runner. -->
    <Compile Include="..\..\src\Bridge\Actions\LatexConverter.cs" Link="Src\LatexConverter.cs" />
    <Compile Include="..\..\src\Bridge\Math\OmmlBuilder.cs" Link="Src\OmmlBuilder.cs" />
    <Compile Include="..\..\src\Bridge\Math\LinearToOmml.cs" Link="Src\LinearToOmml.cs" />
    <Compile Include="..\..\src\Bridge\Math\CfHtml.cs" Link="Src\CfHtml.cs" />
    <Compile Include="..\..\src\Agent\SseEmitter.cs" Link="Src\SseEmitter.cs" />
    <Compile Include="..\..\src\Agent\JsonCompat.cs" Link="Src\JsonCompat.cs" />
    <Compile Include="..\..\src\Agent\ImageDefaults.cs" Link="Src\ImageDefaults.cs" />
    <Compile Include="..\..\src\Agent\ToolPolicy.cs" Link="Src\ToolPolicy.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="LatexConverterTests.cs" />
    <Compile Include="OmmlTests.cs" />
    <Compile Include="CfHtmlTests.cs" />
    <Compile Include="AgentTests.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
